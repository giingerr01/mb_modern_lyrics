{
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true
  },
  "files.trimTrailingWhitespace": true,
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.vs": true
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },
  "[json]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[xml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  }
}
